rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to write to leads collection (for signup form)
    match /leads/{document=**} {
      allow create: if request.resource.data.email is string &&
                       request.resource.data.category is string &&
                       request.resource.data.timestamp is string &&
                       request.resource.data.email.size() > 0;
      allow read: if true; // Allow read for admin dashboard
    }

    // Allow read access to users_access collection (for check-access)
    match /users_access/{document=**} {
      allow read: if true;
      allow create, update: if false; // Only admin backend can write
    }

    // All other collections require authentication
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
